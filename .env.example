# Telegram credentials. Obtain them at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telethon.session
# Use qr for the first interactive login when Telegram does not deliver a phone code.
TELEGRAM_AUTH_MODE=phone

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://saparguard:change-me@localhost:5432/saparguard

# HTTP API and UI
API_HOST=0.0.0.0
API_PORT=8000

# Collector
COLLECTOR_RECONNECT_DELAY_SECONDS=10
COLLECTOR_HISTORY_BATCH_SIZE=100

# Logging
LOG_LEVEL=INFO
LOG_PATH=./logs/saparguard.log

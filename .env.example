# Telegram credentials. Obtain them at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telethon.session
# Use qr for the first interactive login when Telegram does not deliver a phone code.
TELEGRAM_AUTH_MODE=phone
DISPLAY_TIMEZONE=Asia/Almaty

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://saparguard:change-me@localhost:5432/saparguard

# HTTP API and UI
API_HOST=0.0.0.0
API_PORT=8000

# Application authentication. Generate a long random JWT_SECRET for every environment.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256
JWT_COOKIE_NAME=saparguard_session
JWT_COOKIE_SECURE=false
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Google OAuth/OIDC. Leave all three blank to use the disabled fallback widget.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Collector
COLLECTOR_RECONNECT_DELAY_SECONDS=10
COLLECTOR_HISTORY_BATCH_SIZE=100
COLLECTOR_HISTORY_DAYS=7
# Keep this at 1: the shared FastALPR instance is not yet verified as thread-safe.
ALPR_WORKER_COUNT=1
MEDIA_JOB_MAX_ATTEMPTS=3
MEDIA_JOB_RETRY_DELAY_SECONDS=60
MEDIA_JOB_STALE_TIMEOUT_SECONDS=900
TEXT_ANALYSIS_JOB_MAX_ATTEMPTS=3
TEXT_ANALYSIS_JOB_RETRY_DELAY_SECONDS=60
TEXT_ANALYSIS_JOB_STALE_TIMEOUT_SECONDS=900
TEXT_ANALYSIS_POLL_INTERVAL_SECONDS=2
TEXT_ANALYZER_VERSION=20260714.1
PROFILE_RESOLVER_VERSION=profile-v1
PROFILE_JOB_MAX_ATTEMPTS=5
PROFILE_JOB_RETRY_DELAY_SECONDS=30
PROFILE_JOB_STALE_TIMEOUT_SECONDS=900
PROFILE_JOB_POLL_INTERVAL_SECONDS=2
PROFILE_JOB_RECOVERY_INTERVAL_SECONDS=60
PROFILE_PLATE_MIN_CONFIDENCE=0.80
PROFILE_SENDER_RELAY_DISTINCT_PHONE_LIMIT=3

# Limit CPU and allocator pressure on a small VPS.
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
MALLOC_ARENA_MAX=2
API_WORKER_COUNT=1

# Logging
LOG_LEVEL=INFO
LOG_PATH=./logs/saparguard.log
